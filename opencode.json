{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "share": "disabled",
  "enabled_providers": ["gemini"],
  "provider": {
    "gemini": {
      "options": {
        "apiKey": "{env:GEMINI_API_KEY}",
        "timeout": 600000,
        "chunkTimeout": 60000
      }
    }
  }
}
