{
  "languages": {
    "TypeScript": {
      "language_servers": ["typescript-language-server", "..."],
      "formatter": "language_server"
    },
    "TSX": {
      "language_servers": ["typescript-language-server", "..."],
      "formatter": "language_server"
    },
    "JavaScript": {
      "language_servers": ["typescript-language-server", "..."],
      "formatter": "language_server"
    }
  },
  "lsp": {
    "typescript-language-server": {
      "binary": {
        "path": "node_modules/.bin/typescript-language-server"
      },
      "settings": {
        "typescript": {
          "tsdk": "node_modules/typescript/lib"
        },
        "javascript": {
          "tsdk": "node_modules/typescript/lib"
        }
      }
    }
  }
}
